/*
=============================================================
This scripts contains following steps:
Create an OBT for further analysis
EDA & Other analytics based on different stakeholders. 
Starting from GM, Merchandising, Logistics,Seller Success, Customer Service, to Marketing Teams
=============================================================
*/


-- Create OBT for further analysis -- 
DROP VIEW IF EXISTS gold.obt_sales 
CREATE VIEW gold.obt_sales AS
	SELECT s.order_id,
		   s.order_item_id,
		   s.product_id,
		   s.seller_id,
		   s.customer_id,
		   s.customer_unique_id,
		   c.zip_code,
		   c.customer_city,
		   c.customer_state,
		   se.seller_city,
		   se.seller_state,
		   p.category_name,
		   p.category_main AS main_category,
		   p.category_sub AS sub_category,
		   s.order_status,
		   s.order_purchase_timestamp,
		   s.order_approved_at,
		   s.shipping_limit_date,
		   s.order_delivered_carrier_date,
		   s.order_delivered_customer_date,
		   s.order_estimated_delivery_date,
		   s.price,
		   s.freight_value,
		   p.product_weight_g,
		   p.product_height_cm,
		   p.product_width_cm
FROM gold.sales s
LEFT JOIN gold.customers c
ON s.customer_id = c.customer_id
LEFT JOIN gold.sellers se
ON s.seller_id = se.seller_id
LEFT JOIN gold.products p
ON s.product_id = p.product_id


-- Key information for GM -- 
-- Gross Merchandise Volume --
SELECT 
    DATE_TRUNC('month', order_purchase_timestamp) AS order_month,
    SUM(price + freight_value) AS total_gmv,
    COUNT(DISTINCT order_id) AS total_orders
FROM gold.sales
WHERE order_status = 'delivered'
GROUP BY 1
ORDER BY 1 ASC;

-- Top five best selling cities -- 
SELECT customer_city,
	   MAX(customer_state),
SUM(price+freight_value) AS total_sales,
RANK()OVER(ORDER BY SUM(price+freight_value) DESC) AS city_rank
FROM gold.obt_sales
GROUP BY customer_city
LIMIT 5

-- Order Fulfillment Health --
SELECT order_status,
	   COUNT(DISTINCT order_id) AS total_orders,
	   ROUND
	   (COUNT(DISTINCT order_id) * 100 / SUM(COUNT(DISTINCT order_id)) OVER(),2)AS percent_total
FROM gold.obt_sales
GROUP BY order_status
ORDER BY COUNT(DISTINCT order_id)

-- For Merchandising Team --
-- Seasonality: Best-selling Products by Quarter-- 
WITH quarter_rank AS
	(SELECT
		DATE_TRUNC ('quarter', order_purchase_timestamp) AS best_selling_quarter,
		main_category,
		sub_category,
		SUM(price+freight_value)AS total_sales,
		RANK()OVER(PARTITION BY DATE_TRUNC ('quarter', order_purchase_timestamp)
		ORDER BY SUM(price+freight_value) DESC
	    ) AS quarter_category_rank
FROM gold.obt_sales
WHERE order_status = 'delivered'
GROUP BY 1,2,3)

SELECT 
    best_selling_quarter,
    main_category,
	sub_category,
    total_sales,
	quarter_category_rank
FROM quarter_rank
WHERE quarter_category_rank <= 3  
ORDER BY best_selling_quarter ASC, quarter_category_rank ASC;

-- Average Order Value -- 
SELECT 
    main_category,
	sub_category,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(price) AS total_revenue,
    ROUND(SUM(price) / COUNT(DISTINCT order_id), 2) AS aov
FROM gold.obt_sales
WHERE order_status = 'delivered'
GROUP BY 1,2
ORDER BY aov DESC;

-- Freight-to-Price Ratio --
SELECT 
    main_category,
	sub_category,
    ROUND(SUM(freight_value) / SUM(price), 2) AS ftp
FROM gold.obt_sales
WHERE order_status = 'delivered'
GROUP BY 1,2
ORDER BY ftp DESC;

-- Cancellation Rate by Category --
SELECT 
    main_category,
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT CASE WHEN order_status = 'canceled' THEN order_id END) AS canceled_orders,
    ROUND(
        COUNT(DISTINCT CASE WHEN order_status = 'canceled' THEN order_id END) * 100.0 / 
        COUNT(DISTINCT order_id), 
    2) AS cancellation_rate
FROM gold.obt_sales
GROUP BY 1
ORDER BY cancellation_rate DESC;

-- Category Repurchase Rate -- 
WITH customer_purchase_history AS (
    SELECT 
        customer_unique_id, 
        main_category,
		sub_category,
        COUNT(DISTINCT order_id) AS orders_per_customer
    FROM gold.obt_sales
    WHERE order_status = 'delivered'
    GROUP BY 1, 2, 3
)

SELECT 
    main_category,
	sub_category,
    COUNT(DISTINCT customer_unique_id) AS total_unique_customers,
    COUNT(DISTINCT CASE WHEN orders_per_customer > 1 THEN customer_unique_id END) AS returning_customers,
    ROUND(
        COUNT(DISTINCT CASE WHEN orders_per_customer > 1 THEN customer_unique_id END) * 100.0 / 
        COUNT(DISTINCT customer_unique_id), 2) AS repurchase_rate

FROM customer_purchase_history
GROUP BY 1,2
HAVING COUNT(DISTINCT customer_unique_id) > 100
ORDER BY repurchase_rate DESC;

-- For Logistic Team --
-- On-Time Delivery Rate -- 
SELECT 
    customer_state,
    COUNT(DISTINCT order_id) AS total_delivered_orders,
    COUNT(DISTINCT CASE WHEN order_delivered_customer_date > order_estimated_delivery_date THEN order_id END) AS late_orders,
    ROUND(
        COUNT(DISTINCT CASE WHEN order_delivered_customer_date > order_estimated_delivery_date THEN order_id END) * 100.0 / 
        COUNT(DISTINCT order_id), 
    2) AS late_delivery_rate

FROM gold.obt_sales
WHERE order_status = 'delivered' 
  AND order_delivered_customer_date IS NOT NULL 
  AND order_estimated_delivery_date IS NOT NULL
GROUP BY 1
HAVING COUNT(DISTINCT order_id) > 100 
ORDER BY late_delivery_rate DESC;

-- Route Efficieny Analysis-- 
SELECT 
    seller_state AS shipping_origin,
    customer_state AS shipping_destination,
    ROUND(AVG(EXTRACT(DAY FROM (order_delivered_customer_date - order_purchase_timestamp))), 0) AS avg_delivery_days,
    ROUND(AVG(freight_value), 2) AS avg_freight_cost,
    COUNT(*) AS total_orders
FROM gold.obt_sales
WHERE order_status = 'delivered'
  AND order_delivered_customer_date IS NOT NULL
GROUP BY 1, 2
HAVING COUNT(*) > 50 
ORDER BY avg_delivery_days DESC
LIMIT 5;

-- Lost in Transit --
SELECT 
    customer_state AS destination_state,
    COUNT(DISTINCT CASE WHEN order_delivered_carrier_date IS NOT NULL THEN order_id END) AS total_shipped_packages,
    COUNT(DISTINCT CASE WHEN order_delivered_carrier_date IS NOT NULL 
                         AND order_delivered_customer_date IS NULL 
                         AND order_status IN ('canceled', 'unavailable', 'shipped') THEN order_id END) AS lost_packages,
   ROUND(
        COUNT(DISTINCT CASE WHEN order_delivered_carrier_date IS NOT NULL 
                             AND order_delivered_customer_date IS NULL 
                             AND order_status IN ('canceled', 'unavailable', 'shipped') THEN order_id END) * 100.0 / 
        NULLIF(COUNT(DISTINCT CASE WHEN order_delivered_carrier_date IS NOT NULL THEN order_id END), 0), 
    2) AS package_loss_rate
FROM gold.obt_sales
GROUP BY 1
HAVING COUNT(DISTINCT CASE WHEN order_delivered_carrier_date IS NOT NULL THEN order_id END) > 100
ORDER BY package_loss_rate DESC;

-- For Customer Experience Team --
-- Customer LTV Analysis --
WITH customer_lifetime_purchase AS (
    SELECT 
        customer_unique_id,
        COUNT(DISTINCT order_id) AS lifetime_orders,     
        SUM(price + freight_value) AS lifetime_value_ltv, 
        MIN(order_purchase_timestamp) AS first_purchase_date
    FROM gold.obt_sales
    WHERE order_status = 'delivered'
    GROUP BY 1)

-- Customer rentention by segements -- 
SELECT 
    CASE 
        WHEN lifetime_orders = 1 THEN 'One-Time Buyer'
        WHEN lifetime_orders = 2 THEN 'Repeat Buyer'
        WHEN lifetime_orders >= 3 THEN 'Loyal Buyer'
    END AS customer_segment,
    COUNT(customer_unique_id) AS total_users,
    ROUND(
        COUNT(customer_unique_id) * 100.0 / SUM(COUNT(customer_unique_id)) OVER(), 2)
        AS user_percentage,
    ROUND(AVG(lifetime_value_ltv), 2) AS avg_segment_ltv,
    ROUND(SUM(lifetime_value_ltv), 2) AS total_segment_gmv

FROM customer_lifetime_purchase
GROUP BY 1
ORDER BY 3 DESC;

-- For Seller Success Team --
-- Seller Lifespan Analysis --
WITH platform_clock AS (
    SELECT MAX(order_purchase_timestamp) AS max_date 
	FROM gold.obt_sales),

seller_lifespan AS (SELECT 
        s.seller_id,
        MIN(s.order_purchase_timestamp) AS first_sale_date,
        MAX(s.order_purchase_timestamp) AS last_sale_date,
        EXTRACT(DAY FROM (MAX(s.order_purchase_timestamp) - MIN(s.order_purchase_timestamp))) AS lifespan_days,
        EXTRACT(DAY FROM ( 
		(SELECT max_date FROM platform_clock) - MAX(s.order_purchase_timestamp) )) AS inactive_days
        FROM gold.obt_sales s
    WHERE s.order_status = 'delivered'
    GROUP BY 1)

-- Seller Active Analysis --
SELECT 
    CASE 
        WHEN inactive_days > 90 THEN 'Inactive seller'
        WHEN inactive_days BETWEEN 31 AND 90 THEN 'Almost Inactive seller'
        ELSE 'Active'
    END AS seller_status,
    COUNT(seller_id) AS total_sellers,
	ROUND(
        COUNT(seller_id) * 100.0 / SUM(COUNT(seller_id)) OVER(), 2)
        AS seller_percentage,
    ROUND(AVG(lifespan_days), 0) AS avg_lifespan_days

FROM seller_lifespan
GROUP BY 1
ORDER BY 1 ASC;

-- Buyer-Seller Dynamics Analysis -- 
-- Joining review table to OBT -- 
DROP VIEW IF EXISTS gold.obt_sales CASCADE;
CREATE VIEW gold.obt_sales AS

WITH clean_reviews AS (
    SELECT 
        order_id,
        review_score,
        review_creation_date,
        review_answer_timestamp,
        ROW_NUMBER() OVER(PARTITION BY order_id ORDER BY review_answer_timestamp DESC) AS rn
    FROM silver.order_reviews)

SELECT 
    s.*, 
	c.customer_unique_id,
	c.customer_city,
	c.customer_state,
	se.seller_city,
	se.seller_state,
	p.category_name,
	p.category_main AS main_category,
	p.category_sub AS sub_category,
    r.review_score,
    r.review_creation_date,
    r.review_answer_timestamp,
	p.product_weight_g,
	p.product_height_cm,
	p.product_width_cm
FROM gold.sales s
LEFT JOIN gold.customers c
ON s.customer_id = c.customer_id
LEFT JOIN gold.sellers se
ON s.seller_id = se.seller_id
LEFT JOIN gold.products p
ON s.product_id = p.product_id
LEFT JOIN clean_reviews r 
ON s.order_id = r.order_id AND r.rn = 1;

-- First seller impact on customer retention --
-- Lifetime order number -- 
WITH true_lifetime_orders AS (
    SELECT 
        customer_unique_id,
        COUNT(DISTINCT order_id) AS lifetime_order_count
    FROM gold.obt_sales
    WHERE order_status = 'delivered'
    GROUP BY 1
),

-- First order --
first_order_info AS (
    SELECT 
        customer_unique_id,
        review_score AS first_impression_score,
        ROW_NUMBER() OVER(
            PARTITION BY customer_unique_id 
            ORDER BY order_purchase_timestamp ASC
        ) AS rn
    FROM gold.obt_sales
    WHERE order_status = 'delivered'
)

-- Consumer retention rate based on first impression --
SELECT 
    CASE 
        WHEN f.first_impression_score IN (4, 5) THEN 'Best impression'
        WHEN f.first_impression_score = 3 THEN 'Mid impression'
        WHEN f.first_impression_score IN (1, 2) THEN 'Worst impression'
        ELSE 'No review'
    END AS first_impression_tier,
    COUNT(DISTINCT f.customer_unique_id) AS acquired_new_customers,
    COUNT(DISTINCT CASE WHEN t.lifetime_order_count > 1 THEN f.customer_unique_id END) AS retained_customers,
    ROUND(
        COUNT(DISTINCT CASE WHEN t.lifetime_order_count > 1 THEN f.customer_unique_id END) * 100.0 / 
        COUNT(DISTINCT f.customer_unique_id), 
    2) AS repurchased_customer_rate

FROM first_order_info f
JOIN true_lifetime_orders t 
  ON f.customer_unique_id = t.customer_unique_id
WHERE f.rn = 1 
GROUP BY 1
ORDER BY 4 DESC;

