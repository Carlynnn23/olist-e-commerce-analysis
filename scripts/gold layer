/*
=============================================================
Data Integration & Aggregation
Load Data from Sliver layer to Gold layer
=============================================================
Script Purpose:
    This script utilzied star schema to build up joined tables based on sales, customers and products information.
	These tables are then being examined by EDA and other more advanced analytics methods.
    If the database exists, it is dropped and recreated.
*/

-- create dimension (customers) table -- 
DROP VIEW IF EXISTS gold.customers;
CREATE VIEW gold.customers AS
	SELECT  
		c.customer_id,
		c.customer_unique_id,
		c.zip_code,
		COALESCE(c.city,g.city,'unknown') AS customer_city,
		COALESCE(c.state,g.state,'unknown') AS customer_state
FROM silver.customers c
LEFT JOIN silver.geolocation g 
ON c.zip_code=g.zip_code

-- create dimension (sellers) view -- 
DROP VIEW IF EXISTS gold.sellers;
CREATE VIEW gold.sellers AS
	SELECT  
		s.seller_id,
		s.seller_zip_code,
		COALESCE(seller_city,g.city,'unknown') AS seller_city,
		COALESCE(seller_state,g.state,'unknown') AS seller_state
FROM silver.sellers s
LEFT JOIN silver.geolocation g 
ON s.seller_zip_code=g.zip_code

-- create dimension (products) view -- 
DROP VIEW IF EXISTS gold.products;
CREATE VIEW gold.products AS
	SELECT o.product_id,
		   p.product_category_name AS category_name,
		   SPLIT_PART(p.product_category_name, '_', 1) AS category_main,
    	   SPLIT_PART(p.product_category_name, '_', 2) AS category_sub,
		   o.price,
		   o.freight_value,
		   o.shipping_limit_date,
		   p.product_weight_g,
		   p.product_height_cm,
		   p.product_width_cm
  FROM silver.order_items o
  LEFT JOIN silver.products p
  ON o.product_id = p.product_id

-- create fact (sales) view -- 		   
DROP VIEW IF EXISTS gold.sales;
CREATE VIEW gold.sales AS
	SELECT i.order_id,
		   i.order_item_id,
		   i.product_id,
		   i.seller_id,
		   o.customer_id,
		   o.order_status,
		   o.order_purchase_timestamp,
		   o.order_approved_at,
		   i.shipping_limit_date,
		   o.order_delivered_carrier_date,
		   o.order_delivered_customer_date,
		   o.order_estimated_delivery_date,
		   i.price,
		   i.freight_value
		   
FROM silver.order_items i
LEFT JOIN silver.orders o
ON i.order_id=o.order_id
